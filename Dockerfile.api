# Incident Remediation API (FastAPI + LangGraph + Tool Gateway)
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    SQLITE_DB_PATH=/shared/incident_platform.db \
    CHECKPOINT_DB_PATH=/shared/checkpoints.db

# Reasoning backend. The image installs only requirements.txt, which excludes
# the model provider SDKs, so this container reasons deterministically and makes
# no outbound calls. To run a live model, install the `llm` extra in a derived
# image and set LLM_PROVIDER plus the matching API key at runtime.
ENV LLM_PROVIDER=""

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Run as a non-root user; the shared volume must be writable by it.
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /shared /app/.traces \
    && chown -R appuser:appuser /shared /app/.traces
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "mini_platform.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
