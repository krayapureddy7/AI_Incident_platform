# Mini Agentic AI Platform - environment configuration
#
# All settings are optional; the defaults below are what the platform uses when
# the variable is unset. No API keys or external credentials are required: the
# platform runs fully offline against a simulated cluster.

# Durable catalogue of incident runs and audit traces.
SQLITE_DB_PATH=".data/incident_platform.db"

# Durable LangGraph checkpoints. This is what makes a run held for Tier-3
# approval resumable by a different process than the one that proposed it.
CHECKPOINT_DB_PATH=".data/checkpoints.db"

# HMAC key for signing Tier-3 human approval tokens.
#
# Tokens are signed and bound to the action they approve, so knowing the token
# format is not enough to approve anything. When this is unset the platform
# signs with a random per-process key instead of a shipped default: approvals
# then work inside one process (tests, the demo, a single-shot CLI run) but not
# across a restart, and not between the API and a separate approver process.
# Set it for any real deployment, and for CLI approval of an API-held run.
# APPROVAL_SIGNING_SECRET=""

# Session authority for the HTTP API: the environment and tenant this
# deployment is allowed to act on. The safety engine compares a proposal's
# target against these, so they must not come from the request body -- a caller
# supplying both sides could only ever compare a value to itself.
SESSION_ENVIRONMENT="prod"
SESSION_TENANT="default"

# Set to any value to disable ANSI colour in CLI and demo output.
# NO_COLOR="1"
