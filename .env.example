# Mini Agentic AI Platform - environment configuration
#
# All settings are optional; the defaults below are what the platform uses when
# the variable is unset. With none of them set the platform runs fully offline
# against a simulated cluster and reasons deterministically -- no API key and no
# network access are required. Configuring a model provider (below) is the only
# thing that changes that.

# Durable catalogue of incident runs and audit traces.
SQLITE_DB_PATH=".data/incident_platform.db"

# Durable LangGraph checkpoints. This is what makes a run held for Tier-3
# approval resumable by a different process than the one that proposed it.
CHECKPOINT_DB_PATH=".data/checkpoints.db"

# HMAC key for signing Tier-3 human approval tokens.
#
# Tokens are signed and bound to the action they approve, so knowing the token
# format is not enough to approve anything. When this is unset the platform
# signs with a random per-process key instead of a shipped default: approvals
# then work inside one process (tests, the demo, a single-shot CLI run) but not
# across a restart, and not between the API and a separate approver process.
# Set it for any real deployment, and for CLI approval of an API-held run.
# APPROVAL_SIGNING_SECRET=""

# Session authority for the HTTP API: the environment and tenant this
# deployment is allowed to act on. The safety engine compares a proposal's
# target against these, so they must not come from the request body -- a caller
# supplying both sides could only ever compare a value to itself.
SESSION_ENVIRONMENT="prod"
SESSION_TENANT="default"

# --- Reasoning backend -----------------------------------------------------
#
# LLM = reasoning and proposals. Deterministic code = workflow control, safety,
# authorization, and execution. Setting a provider lets the Planner,
# Investigator and Ops agents reason with a model and lets the Verifier narrate
# a verdict it did not reach; it never moves the safety decision, the routing,
# or tool dispatch off the deterministic path.
#
# Unset (the default) means deterministic reasoning, which is what keeps the
# evaluation gate reproducible. "mock" exercises the same LLM code path with
# canned, offline responses and is what CI uses. "gemini", "groq" and
# "openrouter" call a real provider and require the matching key below plus the
# optional extra:
#   pip install -e ".[llm]"
#
# A provider named without its key resolves back to deterministic reasoning
# rather than failing the run; the audit trace records which mode was used.
# LLM_PROVIDER="mock"

# Real values belong in `.env`, which is gitignored. This file is committed --
# never put a live key here.
# GEMINI_API_KEY=""
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""

# Override the provider's default model.
# LLM_MODEL="gemini-3.5-flash"

# --- OpenRouter as a Gemini fallback ----------------------------------------
#
# When LLM_PROVIDER="gemini" and OPENROUTER_API_KEY is also set, a Gemini
# failure (rate limit, outage, missing dependency) routes to OpenRouter instead
# of dropping straight to deterministic reasoning. The same OPENROUTER_API_KEY
# also works standalone with LLM_PROVIDER="openrouter".
#
# Primary OpenRouter model (used either as LLM_PROVIDER="openrouter", or as
# Gemini's fallback).
# OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"

# Comma-separated models OpenRouter itself tries next if OPENROUTER_MODEL is
# unavailable, via OpenRouter's own request-level model fallback.
# OPENROUTER_FALLBACK_MODELS="nvidia/nemotron-3-ultra-550b-a55b:free"

# Wall-clock budget for one generation. Keep it comfortably below the
# LLM-bearing graph nodes' timeout so a slow model degrades to the deterministic
# fallback instead of being abandoned mid-request.
# LLM_TIMEOUT_SEC="20"

# Attempts per generation, including the first. A schema-invalid response is
# retried with the validation error fed back to the model.
# LLM_MAX_ATTEMPTS="2"

# Set to any value to disable ANSI colour in CLI and demo output.
# NO_COLOR="1"
